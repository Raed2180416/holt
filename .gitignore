node_modules/
*.log
.DS_Store
holt-graph.html
coverage/
*.tgz
.stryker-tmp/
__pycache__/

# Operational — must never be committed
.env
.env.*
*.key
*-signing.key
server/data/
licenses.jsonl
.holt-fixtures/
.holt-work/

# Host-specific agent configs are a function of the MACHINE, not the project.
# Contributors run `holt integrate` for whichever host they use — that is the whole promise.
.cursor/
.gemini/
.opencode/
opencode.json
crush.json

# The operator launch runbook names where the licence signing key lives. .npmignore is not
# access control — it stays out of the public repository entirely.
LAUNCH-RUNBOOK.md

# Private session handoff — names unmerged branches, buyer verdicts and pricing decisions.
# Mirrored to ~/.holt-work/. Must not be published.
HANDOFF.md

# Local agent/session artefacts are diagnostic inputs, never repository source.  The
# corresponding integration fixtures and public configuration live under src/, test/,
# and docs/ instead.
.agents/
.codex/
.playwright-mcp/
.playwright-skill/

# This is an explicitly orphaned partial evaluator checkpoint.  It is retained locally
# for diagnosis but must never be merged into a release denominator (see the preregistration).
eval/results.json.checkpoint.jsonl

# the type-check ceiling is tracked, node_modules is not

# SBOMs are generated per release by scripts/gen-sbom.mjs and attached to the GitHub release.
# Committing them would create a fourth surface that rots against the lockfile — the SBOM must
# describe the release it ships with, never a snapshot somebody regenerated once.
holt.cdx.json
holt.spdx.json

# The detached manifest signature is produced in the release workflow from a repository secret.
# MANIFEST.sha256 itself IS committed and IS shipped: it is the thing `holt audit` checks against.
MANIFEST.sha256.sig
