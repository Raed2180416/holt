#
# holt — gap-language definitions for universal-ctags.
#
# MEASURED, NOT ASSUMED. universal-ctags 6.2.1 ships 164 languages, but `ctags --print-language`
# returns NONE for these:
#
#   Swift · Scala · Dart · Groovy · Solidity · Zig · Nim · Crystal · F# · Prolog
#   Dockerfile · GraphQL
#
# That is a real hole for a tool claiming to work on any project: Swift and Dart are most of
# mobile, Scala and Groovy are a large share of the JVM world, and Solidity/Zig/Nim/Crystal are
# where a lot of new code is being written. A symbol layer blind to those languages silently
# reports "no duplicates, no collisions" on entire ecosystems — the exact false-negative this
# tool exists to prevent.
#
# WHY optlib RATHER THAN A SECOND EXTRACTOR:
#   ctags' own parser-definition language (--langdef / --regex-<LANG>) extends ctags itself, so
#   there is ONE symbol pipeline with one output format and one set of downstream semantics.
#   The alternative — a parallel regex path in JavaScript for "the languages ctags lacks" — means
#   two code paths that drift, two sets of kind names, and two places to fix a bug.
#
#   These are regex parsers, so they are less precise than ctags' hand-written C parsers. They
#   are tuned to over-extract rather than under-extract: a spurious symbol produces a finding a
#   human dismisses, while a missed symbol produces silence that reads as "nothing there".
#
# Users can extend this: point HOLT_CTAGS_OPTIONS at your own .ctags file and it is loaded
# after this one, so your definitions win.
#

### Adjustments to ctags' own parsers ##########################################
#
# Function prototypes are OFF by default in the C/C++ parsers, because a prototype is not a
# definition. For holt that default is wrong: two agents each declaring `void handle();` in the
# same header is precisely the collision we exist to report, and with prototypes disabled it is
# invisible. Measured: `void cppMethod();` produced no tag at all until this was enabled.
--kinds-C=+p
--kinds-C++=+p

# NOTE ON AMBIGUOUS EXTENSIONS (.fs, .m, .h, .pl, .r, .v, .t …):
# There is deliberately NO extension remapping here. An earlier revision hardcoded `.fs` to F#
# by taking it away from Forth, which is a guess dressed up as a fix — it is simply wrong for
# every Forth repository, and the same problem recurs for .m (Objective-C vs MATLAB vs Mercury),
# .h (C vs C++ vs Objective-C), .pl (Perl vs Prolog) and a dozen more.
#
# holt resolves these by CONTENT using enry (github.com/go-enry/go-enry) — the Go port of
# GitHub Linguist, with Linguist's own Bayesian classifier trained on Linguist's samples.
# Verified: F#-content .fs -> F#, Forth-content .fs -> Forth, Objective-C .m -> Objective-C,
# MATLAB .m -> MATLAB. See resolveAmbiguous() in src/symbols.mjs.
#
# When enry is not installed, holt falls back to ctags' own extension mapping and REPORTS the
# degradation rather than silently guessing.

### Swift ######################################################################
--langdef=Swift
--map-Swift=+.swift
--kinddef-Swift=f,function,functions
--kinddef-Swift=c,class,classes and protocols
--kinddef-Swift=v,variable,variables
--regex-Swift=/^[ \t]*(public|private|internal|open|fileprivate|static|final|override|mutating|[ \t])*func[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/f/
--regex-Swift=/^[ \t]*(public|private|internal|open|final|indirect|[ \t])*(class|struct|enum|protocol|actor|extension)[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\3/c/
--regex-Swift=/^[ \t]*(public|private|internal|open|static|[ \t])*(let|var)[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\3/v/

### Scala ######################################################################
--langdef=Scala
--map-Scala=+.scala
--map-Scala=+.sc
--kinddef-Scala=f,function,methods
--kinddef-Scala=c,class,classes objects and traits
--kinddef-Scala=v,variable,values
--regex-Scala=/^[ \t]*(private|protected|final|override|implicit|inline|[ \t])*def[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/f/
--regex-Scala=/^[ \t]*(private|protected|final|sealed|abstract|implicit|case|[ \t])*(class|object|trait|enum)[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\3/c/
--regex-Scala=/^[ \t]*(private|protected|final|implicit|lazy|[ \t])*(val|var)[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\3/v/
--regex-Scala=/^[ \t]*type[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\1/c/

### Dart #######################################################################
--langdef=Dart
--map-Dart=+.dart
--kinddef-Dart=f,function,functions
--kinddef-Dart=c,class,classes and mixins
--kinddef-Dart=v,variable,variables
--regex-Dart=/^[ \t]*(abstract|base|final|interface|sealed|[ \t])*(class|mixin|extension|enum)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\3/c/
--regex-Dart=/^[ \t]*(static|final|const|late|[ \t])*[A-Za-z_$][A-Za-z0-9_$<>,? ]*[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)[ \t]*\(/\2/f/
--regex-Dart=/^[ \t]*(static[ \t]+)?(final|const|var|late)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\3/v/
--regex-Dart=/^[ \t]*typedef[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\1/c/

### Groovy #####################################################################
--langdef=Groovy
--map-Groovy=+.groovy
--map-Groovy=+.gradle
--kinddef-Groovy=f,function,methods
--kinddef-Groovy=c,class,classes
--kinddef-Groovy=v,variable,variables
--regex-Groovy=/^[ \t]*(public|private|protected|static|final|abstract|[ \t])*(class|interface|trait|enum)[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\3/c/
--regex-Groovy=/^[ \t]*(public|private|protected|static|final|synchronized|def|[ \t])+([a-zA-Z_][a-zA-Z0-9_]*)[ \t]*\(/\2/f/
--regex-Groovy=/^[ \t]*(def|final)[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \t]*=/\2/v/

### Solidity ###################################################################
--langdef=Solidity
--map-Solidity=+.sol
--kinddef-Solidity=f,function,functions
--kinddef-Solidity=c,class,contracts
--kinddef-Solidity=e,event,events
--kinddef-Solidity=v,variable,state variables
--regex-Solidity=/^[ \t]*(abstract[ \t]+)?(contract|interface|library)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\3/c/
--regex-Solidity=/^[ \t]*function[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\1/f/
--regex-Solidity=/^[ \t]*(event|error)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\2/e/
--regex-Solidity=/^[ \t]*(struct|enum)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\2/c/
--regex-Solidity=/^[ \t]*(uint[0-9]*|int[0-9]*|address|bool|bytes[0-9]*|string|mapping)[^;=]*[ \t](public|private|internal|constant|immutable)[ \t]+([a-zA-Z_$][a-zA-Z0-9_$]*)/\3/v/

### Zig ########################################################################
--langdef=Zig
--map-Zig=+.zig
--kinddef-Zig=f,function,functions
--kinddef-Zig=c,class,structs and enums
--kinddef-Zig=v,variable,constants
--regex-Zig=/^[ \t]*(pub[ \t]+)?(export[ \t]+)?(inline[ \t]+)?fn[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\4/f/
--regex-Zig=/^[ \t]*(pub[ \t]+)?const[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \t]*=[ \t]*(extern[ \t]+|packed[ \t]+)?(struct|enum|union|opaque)/\2/c/
--regex-Zig=/^[ \t]*(pub[ \t]+)?(const|var)[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)[ \t]*[:=]/\3/v/

### Nim ########################################################################
--langdef=Nim
--map-Nim=+.nim
--map-Nim=+.nims
--kinddef-Nim=f,function,procs
--kinddef-Nim=c,class,types
--kinddef-Nim=v,variable,variables
--regex-Nim=/^[ \t]*(proc|func|method|iterator|template|macro|converter)[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/f/
--regex-Nim=/^[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)\*?[ \t]*=[ \t]*(ref[ \t]+)?(object|enum|tuple|distinct)/\1/c/
--regex-Nim=/^[ \t]*(var|let|const)[ \t]+([a-zA-Z_][a-zA-Z0-9_]*)/\2/v/

### Crystal ####################################################################
--langdef=Crystal
--map-Crystal=+.cr
--kinddef-Crystal=f,function,methods
--kinddef-Crystal=c,class,classes and modules
--regex-Crystal=/^[ \t]*def[ \t]+(self\.)?([a-zA-Z_][a-zA-Z0-9_]*[?!=]?)/\2/f/
--regex-Crystal=/^[ \t]*(class|module|struct|enum|lib)[ \t]+([A-Z][a-zA-Z0-9_:]*)/\2/c/

### F# #########################################################################
--langdef=FSharp
--map-FSharp=+.fs
--map-FSharp=+.fsi
--map-FSharp=+.fsx
--kinddef-FSharp=f,function,functions
--kinddef-FSharp=c,class,types and modules
--regex-FSharp=/^[ \t]*let[ \t]+(rec[ \t]+)?(inline[ \t]+)?([a-zA-Z_][a-zA-Z0-9_']*)/\3/f/
--regex-FSharp=/^[ \t]*(type|module|namespace)[ \t]+([a-zA-Z_][a-zA-Z0-9_'.]*)/\2/c/
--regex-FSharp=/^[ \t]*member[ \t]+(this\.|_\.)?([a-zA-Z_][a-zA-Z0-9_']*)/\2/f/

### Prolog #####################################################################
--langdef=Prolog
--map-Prolog=+.pl
--map-Prolog=+.pro
--map-Prolog=+.plt
--kinddef-Prolog=p,predicate,predicates
--regex-Prolog=/^([a-z][a-zA-Z0-9_]*)[ \t]*\(/\1/p/
--regex-Prolog=/^:-[ \t]*(dynamic|discontiguous)[ \t]+([a-z][a-zA-Z0-9_]*)/\2/p/

### Dockerfile #################################################################
--langdef=Dockerfile
--map-Dockerfile=+(Dockerfile)
--map-Dockerfile=+(Dockerfile.*)
--map-Dockerfile=+(*.Dockerfile)
--map-Dockerfile=+.dockerfile
--kinddef-Dockerfile=s,stage,build stages
--kinddef-Dockerfile=a,arg,build arguments
--regex-Dockerfile=/^[ \t]*[Ff][Rr][Oo][Mm][ \t]+[^ \t]+[ \t]+[Aa][Ss][ \t]+([a-zA-Z0-9_.-]+)/\1/s/
--regex-Dockerfile=/^[ \t]*[Aa][Rr][Gg][ \t]+([A-Za-z_][A-Za-z0-9_]*)/\1/a/

### GraphQL ####################################################################
--langdef=GraphQL
--map-GraphQL=+.graphql
--map-GraphQL=+.gql
--kinddef-GraphQL=t,type,types
--kinddef-GraphQL=f,field,operations
--regex-GraphQL=/^[ \t]*(type|input|interface|enum|union|scalar|schema)[ \t]+([A-Za-z_][A-Za-z0-9_]*)/\2/t/
--regex-GraphQL=/^[ \t]*(query|mutation|subscription|fragment)[ \t]+([A-Za-z_][A-Za-z0-9_]*)/\2/f/
