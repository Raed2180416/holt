{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "holt hook pre-tool-use --host claude-code",
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "holt hook session-start --autoprotect --host claude-code",
            "timeout": 120
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "holt hook user-prompt-submit --host claude-code",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
