{
  "name": "holt",
  "version": "0.4.5",
  "mcpName": "io.github.raed2180416/holt",
  "description": "Coordinate, preserve, and safely clean parallel coding-agent worktrees from one evidence model.",
  "type": "module",
  "bin": {
    "holt": "./bin/holt.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./mcp": "./src/mcp/server.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "server.json",
    "docs/MANAGED-POLICY.md",
    "LICENSE-NOTICE.md",
    "MANIFEST.sha256",
    "MANIFEST.sha256.sig",
    "npm-shrinkwrap.json",
    "SUPPLY-CHAIN.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "git": ">=2.45.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "jsonc-parser": "3.3.1",
    "tuf-js": "6.0.0"
  },
  "optionalDependencies": {
    "jscpd": "5.0.14"
  },
  "devDependencies": {
    "@tufjs/repo-mock": "5.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "0.28.1",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "hono": "4.12.34"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node --test \"test/e2e/*.test.mjs\"",
    "selfcheck": "node bin/holt.mjs doctor",
    "test:mutation": "node test/mutation.mjs",
    "test:all": "npm test && npm run test:mutation && npm run typecheck && npm run hosts:check",
    "typecheck": "node scripts/typecheck.mjs",
    "hosts:generate": "node scripts/generate-hosts.mjs",
    "hosts:check": "node scripts/generate-hosts.mjs --check",
    "lint:paths": "node scripts/lint-native-paths.mjs",
    "action:build": "node scripts/build-action-bundle.mjs",
    "action:check": "node scripts/build-action-bundle.mjs --check",
    "test:release-contract": "node --test test/unit/release-contract.test.mjs",
    "manifest": "node scripts/gen-manifest.mjs",
    "audit:supply-chain": "node bin/holt.mjs audit",
    "prepack": "node scripts/gen-manifest.mjs"
  },
  "keywords": [
    "git",
    "worktree",
    "ai-agents",
    "mcp",
    "agentic",
    "developer-tools",
    "cli",
    "git-worktree",
    "parallel-development",
    "claude-code",
    "codex",
    "cursor"
  ],
  "license": "SEE LICENSE IN LICENSE-NOTICE.md",
  "author": "Contrare",
  "homepage": "https://raed2180416.github.io/holt/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raed2180416/holt.git"
  },
  "bugs": {
    "url": "https://github.com/Raed2180416/holt/issues"
  }
}
