{
  "name": "holt",
  "version": "0.2.0",
  "description": "holt™ — know what your agents made, and don't lose any of it: what each worktree produced, which ones collide, which are safe to delete, and a guard that stops an agent deleting work that exists nowhere else.",
  "type": "module",
  "bin": {
    "holt": "./bin/holt.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./mcp": "./src/mcp/server.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:unit": "node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "node --test \"test/e2e/*.test.mjs\"",
    "selfcheck": "node bin/holt.mjs doctor",
    "test:mutation": "node test/mutation.mjs",
    "test:all": "npm test && npm run test:mutation"
  },
  "keywords": [
    "git",
    "worktree",
    "ai-agents",
    "mcp",
    "agentic",
    "developer-tools",
    "cli",
    "git-worktree",
    "parallel-development",
    "claude-code",
    "codex",
    "cursor"
  ],
  "license": "FSL-1.1-MIT",
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "jscpd": "^5.0.14"
  },
  "author": "Contrare",
  "homepage": "https://raed2180416.github.io/holt/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raed2180416/holt.git"
  },
  "bugs": {
    "url": "https://github.com/Raed2180416/holt/issues"
  }
}
